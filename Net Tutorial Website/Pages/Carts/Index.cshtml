@page
@model Net_Tutorial_Website.Pages.Carts.IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
<meta name="request-verification-token" content="@Xsrf.GetAndStoreTokens(HttpContext).RequestToken" />

@{
    ViewData["Title"] = "Index";
}

<h1>Cart</h1>

@if (Model.Cart != null && Model.Cart.Any())
{
    <table class="table" style="color: #ECDBBA;">
        <thead>

            <tr>
                <th>@Html.DisplayNameFor(model => model.Cart[0].Title)</th>
                <th>@Html.DisplayNameFor(model => model.Cart[0].Price)</th>
                <th>Qty</th>
                <th>Total</th>
                <th>Image</th>
                <th></th>
            </tr>
        </thead>
        <form method="post" asp-page-handler="ClearCart" onsubmit="return confirm('Are you sure you want to clear your cart?');">
            <input type="submit" class="btn btn-danger" value="Clear Cart" />
        </form>
        <tbody>
            @foreach (var item in Model.Cart)
            {
                <tr style="background-color: #374045; color: #ECDBBA;" id="row-@item.ID">
                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                    <td>@Html.DisplayFor(modelItem => item.Price)</td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary btn-decrease" data-id="@item.ID">−</button>
                        <span class="mx-2" id="qty-@item.ID">@item.Quantity</span>
                        <button class="btn btn-sm btn-outline-secondary btn-increase" data-id="@item.ID">+</button>
                    </td>
                    <td id="total-@item.ID">@(item.Price * item.Quantity)</td>
                    <td>
                        <img src="@item.ImagePath" style='height: 100%; width: 100%; object-fit: contain; max-width: 160px; max-height: 100px' />
                    </td>
                    <td>
                        <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                        <a asp-page="./Delete" asp-route-id="@item.ID">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p>
        Total price: <span id="cart-total">@Model.Cart.Sum(i => i.Price * i.Quantity)</span> лв.

        <a href="/Checkout">
            <input class="add-to-cart" type="submit" value="Checkout">
        </a>
    </p>
}
else
{
    <p>Your cart is empty.</p>
}
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.btn-increase, .btn-decrease').forEach(btn => {
                btn.addEventListener('click', e => {
                    e.preventDefault();

                    const isIncrease = btn.classList.contains('btn-increase');
                    const id = btn.dataset.id;
                    const handler = isIncrease ? 'IncreaseAjax' : 'DecreaseAjax';
                    const token = document.querySelector('meta[name="request-verification-token"]').content;

                    fetch(`?handler=${handler}&id=${id}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
						 }
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.error) return;

                        if (data.removed) {
                            document.getElementById(`row-${id}`).remove();
                        } else {
                            document.getElementById(`qty-${id}`).textContent = data.quantity;
                            document.getElementById(`total-${id}`).textContent =
                                data.itemTotal.toLocaleString(undefined, { style: 'currency', currency: 'BGN' });
                        }

                        document.getElementById(`cart-total`).textContent =
                            data.cartTotal.toLocaleString(undefined, { style: 'currency', currency: 'BGN' });
                    });
                });
            });
        });
    </script>
}